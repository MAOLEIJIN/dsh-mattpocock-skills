{
  "name": "@maoleijin/dsh-mattpocock-skills",
  "version": "0.1.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Continuously synchronized Matt Pocock skills for DeepSeek Harness, with a verified DSH adaptation overlay.",
  "license": "MIT",
  "author": {
    "name": "Matt Pocock",
    "url": "https://www.aihero.dev"
  },
  "contributors": [
    "DSH adaptation by NmouZh",
    "Upstream synchronization design by auggie246",
    "Maintained by MAOLEIJIN"
  ],
  "homepage": "https://github.com/MAOLEIJIN/dsh-mattpocock-skills",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MAOLEIJIN/dsh-mattpocock-skills.git"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "skill",
    "skills",
    "agent-skills",
    "mattpocock"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "skills",
    "overlay",
    "vendor",
    "tools",
    "test",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "scripts",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "yaml": "^2.4.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1 || ^4.0.2",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.7 <0.2.0-0 || >=0.1.5-rc.1 <0.2.0-0"
  },
  "scripts": {
    "vendor": "node vendor/vendor-skills.mjs",
    "sync": "node vendor/sync-upstream.mjs",
    "sync:local": "node vendor/sync-upstream.mjs --from ../mattpocock-skills",
    "sync:check": "node vendor/sync-upstream.mjs --check",
    "check": "node vendor/sync-upstream.mjs --check",
    "test": "node test/bundle.test.js",
    "verify:profile": "node test/verify-profile.cjs",
    "archive:duplicates": "node tools/archive-duplicates.mjs",
    "overlay:report": "node vendor/overlay-report.mjs",
    "overlay:gen": "node vendor/gen-slash-rules.mjs"
  }
